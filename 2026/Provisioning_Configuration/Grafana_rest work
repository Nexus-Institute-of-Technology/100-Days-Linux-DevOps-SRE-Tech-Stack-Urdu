# Phase 6: Create the Syslog-NG Configuration

## Back up the original

```bash
cp -a /etc/syslog-ng/syslog-ng.conf /etc/syslog-ng/syslog-ng.conf.backup.$(date +%F-%H%M)
```

## Preserve the installed version line

```bash
VERSION_LINE=$(grep -m1 '^@version:' /etc/syslog-ng/syslog-ng.conf)

[ -n "$VERSION_LINE" ] || VERSION_LINE='@version: 3.35'

printf '%s
' "$VERSION_LINE" > /etc/syslog-ng/syslog-ng.conf
```

## Add the configuration

```bash
cat >> /etc/syslog-ng/syslog-ng.conf <<'EOF'
@include "scl.conf"

options {
    chain-hostnames(no);
    flush-lines(1);
    use-dns(no);
    use-fqdn(no);
    keep-hostname(yes);
};

source s_remote_1514 {
    syslog(
        ip("0.0.0.0")
        transport("tcp")
        port(1514)
    );
};

rewrite r_add_origin_1514 {
    set(
        "${SOURCEIP}"
        value(".SDATA.custom@32473.sourceip")
    );

    set(
        "1514"
        value(".SDATA.custom@32473.listener_port")
    );
};

destination d_local_1514 {
    file(
        "/var/log/remote/port-1514/${SOURCEIP}/${YEAR}/${MONTH}/${DAY}/messages.log"

        create-dirs(yes)

        owner("root")
        group("root")
        perm(0640)
        dir-perm(0750)

        template(
            "${ISODATE} listener_port=1514 source_ip=${SOURCEIP} host=${HOST} app=${PROGRAM} pid=${PID} facility=${FACILITY} severity=${LEVEL} message=${MSG}
"
        )
    );
};

destination d_alloy {
    syslog(
        "127.0.0.1"
        transport("tcp")
        port(2514)
    );
};

log {
    source(s_remote_1514);
    rewrite(r_add_origin_1514);

    destination(d_local_1514);
    destination(d_alloy);

    flags(flow-control);
};
EOF
```

