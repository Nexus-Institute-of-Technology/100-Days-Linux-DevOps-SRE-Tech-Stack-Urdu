# Phase 12: Compression and Retention

## Create the maintenance script

```bash
cat > /usr/local/sbin/remote-log-maintenance.sh <<'EOF'
#!/usr/bin/env bash

set -euo pipefail

LOG_ROOT="/var/log/remote"
RETENTION_DAYS=7

find "$LOG_ROOT"     -type f     -name "*.log"     ! -newermt "today"     -exec gzip -f {} +

find "$LOG_ROOT"     -type f     -name "*.gz"     -mtime +"$RETENTION_DAYS"     -delete

find "$LOG_ROOT"     -mindepth 1     -type d     -empty     -delete
EOF
```

```bash
chmod 0750 /usr/local/sbin/remote-log-maintenance.sh
```

## Create the systemd service

```bash
cat > /etc/systemd/system/remote-log-maintenance.service <<'EOF'
[Unit]
Description=Compress and remove expired remote syslog files

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/remote-log-maintenance.sh
EOF
```

## Create the timer

```bash
cat > /etc/systemd/system/remote-log-maintenance.timer <<'EOF'
[Unit]
Description=Run remote-log maintenance daily

[Timer]
OnCalendar=*-*-* 00:15:00
Persistent=true

[Install]
WantedBy=timers.target
EOF
```

Enable:

```bash
systemctl daemon-reload
systemctl enable --now remote-log-maintenance.timer
```

Confirm:

```bash
systemctl list-timers remote-log-maintenance.timer
```

Test manually:

```bash
systemctl start remote-log-maintenance.service

systemctl status remote-log-maintenance.service --no-pager
```

